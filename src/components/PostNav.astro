---
// Static prev/next footer navigation. Drives off the same flat reading
// order the left ToC sidebar uses (src/lib/chapter-order.ts), so the two
// never drift apart. Because `order` is a cross-chapter flat array,
// prev/next flow across chapter boundaries for free - no special-casing
// needed. Zero client-side JS: this component ships no <script>.
import { getReadingOrder } from '../lib/chapter-order';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const order = await getReadingOrder();
const i = order.findIndex((p) => p.data.slug === currentSlug);
const prev = i > 0 ? order[i - 1] : null;
const next = i >= 0 && i < order.length - 1 ? order[i + 1] : null;
---

<nav class="post-nav" aria-label="Post navigation">
  {prev && (
    <a class="post-nav-prev" href={`/posts/${prev.data.slug}/`}>
      <span class="post-nav-label">Previous</span>
      <span>&larr; {prev.data.title}</span>
    </a>
  )}
  {next && (
    <a class="post-nav-next" href={`/posts/${next.data.slug}/`}>
      <span class="post-nav-label">Next</span>
      <span>{next.data.title} &rarr;</span>
    </a>
  )}
</nav>
