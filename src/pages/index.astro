---
import { getChapters, splitChapter } from '../lib/chapter-order';
import Layout from '../layouts/Layout.astro';

const chapters = await getChapters();
---

<Layout title="Learn Me a Threat">
  <h1>Learn Me a Threat</h1>
  <p class="intro">
    A ground-up explainer series on how quantum computing threatens
    Bitcoin, one concept at a time, nothing assumed.
  </p>

  {chapters.size === 0 ? (
    <div class="empty-state">
      <h2>No posts yet.</h2>
      <p>Check back soon &mdash; the first post is on its way.</p>
    </div>
  ) : (
    [...chapters].map(([chapterName, chapterPosts]) => {
      const { sectionPost, subsectionPosts } = splitChapter(chapterPosts);
      return (
        <section class="chapter">
          {sectionPost ? (
            <>
              <ul class="post-list">
                <li>
                  <a class="post-title" href={`/posts/${sectionPost.data.slug}/`}>{sectionPost.data.title}</a>
                  <p class="meta">
                    {sectionPost.data.date.toDateString()} &middot; {sectionPost.data.tags.join(', ')}
                  </p>
                  <p class="excerpt">{sectionPost.data.excerpt}</p>
                </li>
              </ul>
              {subsectionPosts.length > 0 && (
                <ul class="subsection-list">
                  {subsectionPosts.map((post) => (
                    <li>
                      <a class="post-title" href={`/posts/${post.data.slug}/`}>{post.data.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </>
          ) : (
            <>
              <h2>{chapterName}</h2>
              <ul class="post-list">
              {chapterPosts.map((post) => (
                <li>
                  <a class="post-title" href={`/posts/${post.data.slug}/`}>{post.data.title}</a>
                  <p class="meta">
                    {post.data.date.toDateString()} &middot; {post.data.tags.join(', ')}
                  </p>
                  <p class="excerpt">{post.data.excerpt}</p>
                </li>
              ))}
              </ul>
            </>
          )}
        </section>
      );
    })
  )}
</Layout>

<style>
  .intro {
    color: var(--muted);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .post-title {
    font-size: 24px;
    font-weight: 600;
    text-decoration: none;
  }

  .post-list .meta {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
    margin: var(--space-xs) 0;
  }

  .post-list .excerpt {
    margin: 0;
  }

  .chapter + .chapter {
    margin-top: var(--space-xl);
  }

  .subsection-list {
    list-style: none;
    margin: 0;
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
</style>
