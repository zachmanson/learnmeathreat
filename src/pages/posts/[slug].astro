---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LeftNavSidebar from '../../components/LeftNavSidebar.astro';
import RightNavSidebar from '../../components/RightNavSidebar.astro';
import PostNav from '../../components/PostNav.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// D-08: outline covers only h2/h3 - h4-h6 are excluded even though plan 01
// numbers them. Note (RESEARCH.md Pitfall 2): headings[].text for a heading
// containing inline $math$ may come back garbled from KaTeX's dual-
// representation markup - neither seed post has math in a heading today, so
// no cleanup pass is added now; revisit when the first such heading ships.
const outlineHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={post.data.title}>
  <div class="post-layout">
    <LeftNavSidebar currentSlug={post.data.slug} currentTags={post.data.tags} />
    <article>
      <h1>{post.data.title}</h1>
      <p class="meta">
        {post.data.date.toDateString()} &middot; {post.data.tags.join(', ')}
      </p>
      <Content />
      <PostNav currentSlug={post.data.slug} />
    </article>
    {outlineHeadings.length >= 2 && <RightNavSidebar headings={outlineHeadings} />}
  </div>
</Layout>
